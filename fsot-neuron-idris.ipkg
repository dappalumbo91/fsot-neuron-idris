brief = "FSOT neural mind — Phase A full twin of fsot-neuron-zig"

depends = base, contrib

sourcedir = "src"

modules = Fsot.Trit
        , Fsot.Seeds
        , Fsot.Fixed
        , Fsot.Codon
        , Fsot.CellTypes
        , Fsot.Genotype
        , Fsot.BioProbe
        , Fsot.GeneticCore
        , Fsot.AllenIsiKs
        , Fsot.ScalpelRate
        , Fsot.Neuron
        , Fsot.Memory
        , Fsot.Organism
        , Fsot.IntelLoop
        , Fsot.ComposeIntel
        , Fsot.InternalThink
        , Fsot.BioLearn
        , Fsot.BioEmbodied
        , Fsot.PhaseA
        , Fsot.PhaseB
        , Fsot.PhaseC
        , Fsot.PhaseD
        , Fsot.Glia
        , Fsot.SelfTalk
        , Fsot.LiveMind
        , Fsot.Mind

main = Main
executable = fsot-mind
