package fsot-neuron-idris
version = 0.2.1.0

authors = "FSOT"
maintainers = "FSOT"
license = "Apache-2.0"
brief = "FSOT neural mind — DNA/trinary/FSOT genetic spine (Idris2)"

depends = base, contrib

sourcedir = "src"

modules = Fsot.Trit
        , Fsot.Seeds
        , Fsot.Fixed
        , Fsot.Codon
        , Fsot.CellTypes
        , Fsot.Genotype
        , Fsot.BioProbe
        , Fsot.GeneticCore
        , Fsot.Mind

main = Main
executable = fsot-mind
